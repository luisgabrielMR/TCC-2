# Copie este arquivo para .env se quiser sobrescrever valores locais.
# Nao versionar o arquivo .env real.

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=benchmark_db
POSTGRES_USER=benchmark_user
POSTGRES_PASSWORD=benchmark_password
DATABASE_URL=postgresql://benchmark_user:benchmark_password@localhost:5432/benchmark_db

# Porta padrao da API ativa exposta para testes manuais
API_BASE_URL=http://localhost:8000
API_EXTERNAL_PORT=8000

# Configuracao equivalente de pool
DB_POOL_MIN=1
DB_POOL_MAX=20
DB_POOL_ACQUIRE_TIMEOUT_SECONDS=10
DB_POOL_IDLE_TIMEOUT_SECONDS=60
DB_POOL_MAX_LIFETIME_SECONDS=300

# Locust e aquecimento
LOCUST_HOST=http://localhost:8000
LOCUST_USERS=50
LOCUST_SPAWN_RATE=10
LOCUST_DURATION=5m
WARMUP_DURATION_SECONDS=180
WARMUP_USERS=20
WARMUP_SPAWN_RATE=5

# Resultados
RESULTS_DIR=results
RUN_ORDER=python,node,java,go,dotnet

# Monitoramento
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Imagens base usadas pelo docker-compose
POSTGRES_IMAGE=postgres:17
LOCUST_IMAGE=locustio/locust:2.32.6
PROMETHEUS_IMAGE=prom/prometheus:v2.55.1
GRAFANA_IMAGE=grafana/grafana:11.3.0
POSTGRES_EXPORTER_IMAGE=prometheuscommunity/postgres-exporter:v0.15.0
CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor:v0.49.1
