# Copie este arquivo para .env se quiser sobrescrever valores locais.
# Nao versionar o arquivo .env real.

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=benchmark_db
POSTGRES_USER=benchmark_user
POSTGRES_PASSWORD=benchmark_password
DATABASE_URL=postgresql://benchmark_user:benchmark_password@localhost:5432/benchmark_db

# Porta padrao da API ativa exposta para testes manuais
API_BASE_URL=http://127.0.0.1:8000
API_EXTERNAL_PORT=8000

# Configuracao equivalente de pool
DB_POOL_MIN=1
DB_POOL_MAX=20
DB_POOL_ACQUIRE_TIMEOUT_SECONDS=10
DB_POOL_IDLE_TIMEOUT_SECONDS=60
DB_POOL_MAX_LIFETIME_SECONDS=1800

# Locust e aquecimento
# URL vista pelo Locust, que roda dentro de um container Docker.
LOCUST_HOST=http://host.docker.internal:8000
LOCUST_USERS=50
LOCUST_SPAWN_RATE=10
LOCUST_DURATION=5m
LOCUST_WAIT_SECONDS=0.1
WARMUP_DURATION_SECONDS=180
WARMUP_RETRY_DURATION_SECONDS=300
WARMUP_STABILITY_WINDOW_SECONDS=45
WARMUP_MAX_RPS_DRIFT_PERCENT=10

# Resultados
RESULTS_DIR=results
RUN_ORDER=python,node,java,go,dotnet

# Monitoramento
PROMETHEUS_PORT=9090
METRICS_SAMPLE_INTERVAL_SECONDS=2
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Imagens base usadas pelo docker-compose
POSTGRES_IMAGE=postgres:17@sha256:0027bef26712baaee437a4ea48fdf3d2d2e2bc5f0d81615374408ca320f3c7e3
LOCUST_IMAGE=locustio/locust:2.32.6@sha256:99278f4b23e2353e7a93b84f9c270700c8193b90c1611f5c2a1817a111c22ee3
PROMETHEUS_IMAGE=prom/prometheus:v2.55.1@sha256:2659f4c2ebb718e7695cb9b25ffa7d6be64db013daba13e05c875451cf51b0d3
GRAFANA_IMAGE=grafana/grafana:11.3.0@sha256:a0f881232a6fb71a0554a47d0fe2203b6888fe77f4cefb7ea62bed7eb54e13c3
POSTGRES_EXPORTER_IMAGE=prometheuscommunity/postgres-exporter:v0.15.0@sha256:386b12d19eab2a37d7cd8ca8b4c7491cc7a830d9581f49af6c98a393da9605e6
CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor:v0.49.1@sha256:3cde6faf0791ebf7b41d6f8ae7145466fed712ea6f252c935294d2608b1af388
